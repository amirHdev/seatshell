import { ShellTheme } from "shell-theme.slint";
import { ShellAction, ShellIcon } from "shell-widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component PowerMenu inherits Rectangle {
    in property <string> user-name;
    callback close();
    callback request-action(string);

    background: #050a10aa;

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        x: max(12px, (root.width - min(360px, root.width - 24px)) / 2);
        y: max(12px, (root.height - min(330px, root.height - 24px)) / 2);
        width: min(360px, root.width - 24px);
        height: min(330px, root.height - 24px);
        background: #0b1420f2;
        border-radius: 20px;
        border-width: 1px;
        border-color: #ffffff28;

        VerticalLayout {
            padding: 16px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 10px;
                alignment: center;

                Rectangle {
                    width: 38px;
                    height: 38px;
                    background: ShellTheme.surface-accent;
                    border-radius: 999px;

                    ShellIcon {
                        x: 10px;
                        y: 10px;
                        width: 18px;
                        height: 18px;
                        name: "user";
                        icon-color: ShellTheme.text-accent;
                    }
                }

                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: root.user-name;
                        color: ShellTheme.text-primary;
                        font-size: 15px;
                        font-weight: 800;
                    }

                    Text {
                        text: "Session actions";
                        color: ShellTheme.text-muted;
                        font-size: 10px;
                    }
                }

                ShellAction {
                    label: "";
                    icon-name: "close";
                    compact: true;
                    clicked => {
                        root.close();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #ffffff18;
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;

                VerticalLayout {
                    spacing: 10px;

                    ShellAction {
                        label: "Lock screen";
                        icon-name: "lock";
                        compact: true;
                        fill: true;
                        clicked => {
                            root.request-action("lock");
                        }
                    }

                    ShellAction {
                        label: "Sign out";
                        icon-name: "sessions";
                        compact: true;
                        fill: true;
                        clicked => {
                            root.request-action("sign out");
                        }
                    }

                    ShellAction {
                        label: "Restart";
                        icon-name: "settings";
                        compact: true;
                        fill: true;
                        clicked => {
                            root.request-action("restart");
                        }
                    }

                    ShellAction {
                        label: "Power off";
                        icon-name: "power";
                        compact: true;
                        fill: true;
                        clicked => {
                            root.request-action("power off");
                        }
                    }

                    Text {
                        text: "Lock and sign out use the admin session service when available. Restart and power off still need system power integration.";
                        color: ShellTheme.text-muted;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
