import { Panel } from "panel.slint";
import { Desktop } from "desktop.slint";
import { CommandSurface } from "command-surface.slint";
import { Launcher, LauncherApp } from "launcher.slint";
import { NotificationCenter, NotificationEntry } from "notification-center.slint";
import { Overview, UserSession } from "overview.slint";
import { DesktopFile, DesktopShortcutEntry, DesktopWindowEntry } from "desktop.slint";
import { PowerMenu } from "power-menu.slint";
import { SettingsPage } from "settings.slint";
import { SystemCenter } from "system-center.slint";
import { ShellTheme } from "shell-theme.slint";

export component AppWindow inherits Window {
    in property <int> requested-width: 1180;
    in property <int> requested-height: 680;
    in property <int> panel-height: root.width < 700px ? 68 : 60;
    in property <string> accent: "#4a90e2";
    in property <[LauncherApp]> launcher-apps;
    in property <[LauncherApp]> featured-apps;
    in property <[LauncherApp]> recent-apps;
    in property <[LauncherApp]> active-apps;
    in property <[DesktopWindowEntry]> desktop-windows;
    in property <[DesktopFile]> recent-files;
    in property <[DesktopShortcutEntry]> desktop-shortcuts;
    in property <string> selected-desktop-shortcut-id;
    in property <[LauncherApp]> panel-apps;
    in property <[NotificationEntry]> notifications;
    in property <[UserSession]> user-sessions;
    in property <string> clock-text;
    in property <string> status-text: "SeatShell ready";
    in property <string> network-text: "NET";
    in property <string> power-text: "PWR";
    in property <string> audio-text: "VOL ?";
    in property <string> user-name: "unknown";
    in property <string> theme-name: "dark";
    in property <image> wallpaper-image;
    in property <string> launcher-query;
    in property <int> launcher-count;
    in property <int> app-count: 0;
    in property <int> session-count: 0;
    in property <int> notification-count: 0;
    in property <bool> windowed: false;
    in property <bool> panel-on-top: false;
    in property <bool> show-user-switcher: true;
    in-out property <bool> show-launcher: false;
    in-out property <bool> show-overview: false;
    in-out property <bool> show-command-surface: false;
    in-out property <bool> show-notifications: false;
    in-out property <bool> show-system-center: false;
    in-out property <bool> show-settings: false;
    in-out property <bool> show-power-menu: false;
    in property <bool> overview-enabled: true;
    out property <int> desktop-surface-width: root.width / 1px;
    out property <int> desktop-surface-height: max(0, (root.height - root.panel-height * 1px) / 1px);
    out property <bool> desktop-phone: root.desktop-surface-width < 560;
    out property <bool> desktop-wide: root.desktop-surface-width >= 1180;
    out property <bool> desktop-full-layout: root.desktop-surface-width >= 900;
    out property <int> desktop-shortcut-lane-width: max(0, root.desktop-surface-width - 24);
    out property <int> desktop-shortcut-lane-y: 12;
    out property <int> desktop-shortcut-lane-height: max(0, root.desktop-surface-height - 24);
    out property <int> desktop-shortcut-max-x: max(0, root.desktop-shortcut-lane-width - 108);
    out property <int> desktop-shortcut-max-y: max(0, root.desktop-shortcut-lane-height - 112);

    callback toggle-launcher();
    callback toggle-overview();
    callback show-desktop();
    callback launch-app(string);
    callback focus-window(string);
    callback minimize-window(string);
    callback maximize-window(string);
    callback close-window(string);
    callback move-window(string, int, int, int, int);
    callback resize-window(string, int, int);
    callback toggle-command-surface();
    callback toggle-notifications();
    callback request-shell-action(string);
    callback toggle-network();
    callback volume-down();
    callback volume-up();
    callback toggle-mute();
    callback clear-notifications();
    callback dismiss-notification(int);
    callback open-file(string);
    callback select-desktop-shortcut(string);
    callback clear-desktop-shortcut-selection();
    callback select-all-desktop-shortcuts();
    callback marquee-select-desktop-shortcuts(int, int, int, int, int, int);
    callback move-desktop-shortcut-selection(int, int);
    callback nudge-selected-desktop-shortcuts(int, int, int, int);
    callback auto-arrange-desktop-shortcuts(int, int);
    callback move-desktop-shortcut(string, int, int, int, int);
    callback launcher-search-changed(string);
    callback launcher-accept-search();
    callback move-launcher-selection(int);
    callback toggle-favorite-app(string);
    callback move-overview-selection(int);
    callback activate-current-session();

    title: "SeatShell";
    width: root.requested-width * 1px;
    height: root.requested-height * 1px;
    no-frame: !root.windowed;
    full-screen: !root.windowed;
    background: ShellTheme.background;

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        if root.panel-on-top: Panel {
            height: root.panel-height * 1px;
            accent: root.accent;
            clock-text: root.clock-text;
            status-text: root.status-text;
            network-text: root.network-text;
            power-text: root.power-text;
            audio-text: root.audio-text;
            panel-apps: root.panel-apps;
            app-count: root.app-count;
            session-count: root.session-count;
            notification-count: root.notification-count;
            show-launcher: root.show-launcher;
            show-overview: root.show-overview;
            show-notifications: root.show-notifications;
            show-system-center: root.show-system-center;
            show-user-switcher: root.show-user-switcher;
            show-desktop => {
                root.show-desktop();
            }
            toggle-launcher => {
                root.toggle-launcher();
            }
            toggle-overview => {
                if root.overview-enabled {
                    root.toggle-overview();
                }
            }
            toggle-notifications => {
                root.toggle-notifications();
            }
            toggle-system-center => {
                root.show-system-center = !root.show-system-center;
                root.show-notifications = false;
                root.show-power-menu = false;
            }
            toggle-network => {
                root.toggle-network();
            }
            volume-down => {
                root.volume-down();
            }
            volume-up => {
                root.volume-up();
            }
            toggle-mute => {
                root.toggle-mute();
            }
            launch-app(id) => {
                root.launch-app(id);
            }
        }

        Rectangle {
            background: ShellTheme.background;
            vertical-stretch: 1;

            if show-settings: SettingsPage {
                network-text: root.network-text;
                audio-text: root.audio-text;
                power-text: root.power-text;
                theme-name: root.theme-name;
                session-count: root.session-count;
                close => {
                    root.show-settings = false;
                }
            }

            if !show-settings && show-overview: Overview {
                accent: root.accent;
                sessions: root.user-sessions;
                status-text: root.status-text;
                move-selection(step) => {
                    root.move-overview-selection(step);
                }
                activate-current-session => {
                    root.activate-current-session();
                }
                close => {
                    root.show-desktop();
                }
            }

            if !show-settings && show-launcher: Launcher {
                accent: root.accent;
                apps: root.launcher-apps;
                featured-apps: root.featured-apps;
                recent-apps: root.recent-apps;
                query: root.launcher-query;
                app-count: root.launcher-count;
                launch-app(command) => {
                    root.launch-app(command);
                }
                search-changed(text) => {
                    root.launcher-search-changed(text);
                }
                accept-search => {
                    root.launcher-accept-search();
                }
                move-selection(step) => {
                    root.move-launcher-selection(step);
                }
                toggle-favorite(id) => {
                    root.toggle-favorite-app(id);
                }
                close => {
                    root.show-desktop();
                }
            }

            if !show-settings && !show-overview && !show-launcher: Desktop {
                accent: root.accent;
                clock-text: root.clock-text;
                status-text: root.status-text;
                network-text: root.network-text;
                power-text: root.power-text;
                audio-text: root.audio-text;
                apps: root.launcher-apps;
                featured-apps: root.featured-apps;
                recent-apps: root.recent-apps;
                active-apps: root.active-apps;
                desktop-windows: root.desktop-windows;
                recent-files: root.recent-files;
                desktop-shortcuts: root.desktop-shortcuts;
                selected-shortcut-id: root.selected-desktop-shortcut-id;
                user-name: root.user-name;
                theme-name: root.theme-name;
                wallpaper-image: root.wallpaper-image;
                app-count: root.app-count;
                session-count: root.session-count;
                notification-count: root.notification-count;
                overview-enabled: root.overview-enabled;
                show-launcher => {
                    root.toggle-launcher();
                }
                show-command-surface => {
                    root.toggle-command-surface();
                }
                show-overview => {
                    if root.overview-enabled {
                        root.toggle-overview();
                    }
                }
                launch-app(id) => {
                    root.launch-app(id);
                }
                focus-window(id) => {
                    root.focus-window(id);
                }
                minimize-window(id) => {
                    root.minimize-window(id);
                }
                maximize-window(id) => {
                    root.maximize-window(id);
                }
                close-window(id) => {
                    root.close-window(id);
                }
                move-window(id, x, y, max-x, max-y) => {
                    root.move-window(id, x, y, max-x, max-y);
                }
                resize-window(id, width, height) => {
                    root.resize-window(id, width, height);
                }
                open-file(path) => {
                    root.open-file(path);
                }
                select-desktop-shortcut(app-id) => {
                    root.select-desktop-shortcut(app-id);
                }
                clear-desktop-shortcut-selection => {
                    root.clear-desktop-shortcut-selection();
                }
                select-all-desktop-shortcuts => {
                    root.select-all-desktop-shortcuts();
                }
                marquee-select-desktop-shortcuts(x, y, width, height, max-x, max-y) => {
                    root.marquee-select-desktop-shortcuts(x, y, width, height, max-x, max-y);
                }
                move-desktop-shortcut-selection(dx, dy) => {
                    root.move-desktop-shortcut-selection(dx, dy);
                }
                nudge-selected-desktop-shortcuts(dx, dy, max-x, max-y) => {
                    root.nudge-selected-desktop-shortcuts(dx, dy, max-x, max-y);
                }
                auto-arrange-desktop-shortcuts(max-x, max-y) => {
                    root.auto-arrange-desktop-shortcuts(max-x, max-y);
                }
                move-desktop-shortcut(app-id, x, y, max-x, max-y) => {
                    root.move-desktop-shortcut(app-id, x, y, max-x, max-y);
                }
            }

            if !show-settings && !show-overview && !show-launcher && show-command-surface: CommandSurface {
                accent: root.accent;
                overview-enabled: root.overview-enabled;
                featured-apps: root.featured-apps;
                recent-apps: root.recent-apps;
                close => {
                    root.toggle-command-surface();
                }
                show-launcher => {
                    root.toggle-command-surface();
                    root.toggle-launcher();
                }
                show-overview => {
                    root.toggle-command-surface();
                    if root.overview-enabled {
                        root.toggle-overview();
                    }
                }
                launch-app(id) => {
                    root.launch-app(id);
                }
            }

            if show-system-center: SystemCenter {
                clock-text: root.clock-text;
                network-text: root.network-text;
                power-text: root.power-text;
                audio-text: root.audio-text;
                user-name: root.user-name;
                notification-count: root.notification-count;
                session-count: root.session-count;
                close => {
                    root.show-system-center = false;
                }
                toggle-network => {
                    root.toggle-network();
                }
                volume-down => {
                    root.volume-down();
                }
                volume-up => {
                    root.volume-up();
                }
                toggle-mute => {
                    root.toggle-mute();
                }
                open-notifications => {
                    root.show-system-center = false;
                    root.toggle-notifications();
                }
                open-settings => {
                    root.show-system-center = false;
                    root.show-settings = true;
                }
                open-power-menu => {
                    root.show-system-center = false;
                    root.show-power-menu = true;
                }
                open-overview => {
                    root.show-system-center = false;
                    if root.overview-enabled {
                        root.toggle-overview();
                    }
                }
            }

            if show-notifications: NotificationCenter {
                notifications: root.notifications;
                clear-all => {
                    root.clear-notifications();
                }
                dismiss-notification(id) => {
                    root.dismiss-notification(id);
                }
                close => {
                    root.toggle-notifications();
                }
            }

            if show-power-menu: PowerMenu {
                user-name: root.user-name;
                close => {
                    root.show-power-menu = false;
                }
                request-action(action) => {
                    root.show-power-menu = false;
                    root.request-shell-action(action);
                }
            }
        }

        if !root.panel-on-top: Panel {
            height: root.panel-height * 1px;
            accent: root.accent;
            clock-text: root.clock-text;
            status-text: root.status-text;
            network-text: root.network-text;
            power-text: root.power-text;
            audio-text: root.audio-text;
            panel-apps: root.panel-apps;
            app-count: root.app-count;
            session-count: root.session-count;
            notification-count: root.notification-count;
            show-launcher: root.show-launcher;
            show-overview: root.show-overview;
            show-notifications: root.show-notifications;
            show-system-center: root.show-system-center;
            show-user-switcher: root.show-user-switcher;
            show-desktop => {
                root.show-desktop();
            }
            toggle-launcher => {
                root.toggle-launcher();
            }
            toggle-overview => {
                if root.overview-enabled {
                    root.toggle-overview();
                }
            }
            toggle-notifications => {
                root.toggle-notifications();
            }
            toggle-system-center => {
                root.show-system-center = !root.show-system-center;
                root.show-notifications = false;
                root.show-power-menu = false;
            }
            toggle-network => {
                root.toggle-network();
            }
            volume-down => {
                root.volume-down();
            }
            volume-up => {
                root.volume-up();
            }
            toggle-mute => {
                root.toggle-mute();
            }
            launch-app(id) => {
                root.launch-app(id);
            }
        }
    }
}
