import { LauncherApp } from "launcher.slint";
import { ShellTheme } from "shell-theme.slint";
import { DockItem, ShellAction, ShellIcon, ShellPill } from "shell-widgets.slint";

export component Panel inherits Rectangle {
    in property <string> accent: "#4a90e2";
    in property <string> clock-text;
    in property <string> status-text: "Ready";
    in property <string> network-text: "NET";
    in property <string> power-text: "PWR";
    in property <string> audio-text: "VOL ?";
    in property <[LauncherApp]> panel-apps;
    in property <int> app-count: 0;
    in property <int> session-count: 0;
    in property <int> notification-count: 0;
    in property <bool> show-launcher: false;
    in property <bool> show-overview: false;
    in property <bool> show-notifications: false;
    in property <bool> show-system-center: false;
    in property <bool> show-user-switcher: true;

    in property <bool> micro: root.width < 420px;
    in property <bool> phone: root.width < 620px;
    in property <bool> narrow: root.width < 900px;
    in property <bool> compact: root.width < 1180px;

    callback toggle-launcher();
    callback toggle-overview();
    callback toggle-notifications();
    callback toggle-system-center();
    callback toggle-network();
    callback volume-down();
    callback volume-up();
    callback toggle-mute();
    callback show-desktop();
    callback launch-app(string);

    background: #050a10e6;
    border-width: 1px;
    border-color: #ffffff18;

    HorizontalLayout {
        padding-left: root.phone ? 6px : 14px;
        padding-right: root.phone ? 6px : 14px;
        spacing: root.phone ? 4px : 12px;
        alignment: center;

        Rectangle {
            width: root.micro ? 34px : root.phone ? 38px : 54px;
            height: parent.height;
            background: transparent;

            Rectangle {
                width: root.micro ? 30px : root.phone ? 32px : 36px;
                height: root.micro ? 30px : root.phone ? 32px : 36px;
                x: 0px;
                y: (parent.height - self.height) / 2;
                background: ShellTheme.accent;
                border-radius: 10px;
                border-width: 1px;
                border-color: #ffffff28;

                ShellIcon {
                    x: 9px;
                    y: 9px;
                    width: parent.width - 18px;
                    height: parent.height - 18px;
                    name: "brand";
                    icon-color: #1a120d;
                }

                TouchArea {
                    clicked => {
                        root.toggle-launcher();
                    }
                }
            }
        }

        Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            background: transparent;
            clip: true;

            Rectangle {
                width: min(parent.width, root.micro ? 112px : root.phone ? 180px : root.narrow ? 300px : 460px);
                height: root.phone ? 42px : 52px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                background: #101823c8;
                border-radius: root.phone ? 15px : 18px;
                border-width: 1px;
                border-color: #ffffff22;
                clip: true;

                HorizontalLayout {
                    padding-left: root.micro ? 4px : root.phone ? 6px : 10px;
                    padding-right: root.micro ? 4px : root.phone ? 6px : 10px;
                    spacing: root.phone ? 4px : 8px;
                    alignment: center;

                    DockItem {
                        label: "";
                        icon-name: "desktop";
                        active: !root.show-launcher && !root.show-overview;
                        compact: true;
                        tiny: root.phone;
                        clicked => {
                            root.show-desktop();
                        }
                    }

                    DockItem {
                        label: "";
                        icon-name: "apps";
                        active: root.show-launcher;
                        compact: true;
                        tiny: root.phone;
                        clicked => {
                            root.toggle-launcher();
                        }
                    }

                    if root.show-user-switcher && !root.narrow: DockItem {
                        label: "";
                        icon-name: "sessions";
                        active: root.show-overview;
                        compact: true;
                        clicked => {
                            root.toggle-overview();
                        }
                    }

                    for app in root.panel-apps: DockItem {
                        label: "";
                        icon-text: app.icon_text;
                        icon: app.icon;
                        active: false;
                        running-count: app.running_count;
                        compact: true;
                        tiny: root.phone;
                        visible: !root.narrow;
                        width: root.narrow ? 0px : 38px;
                        clicked => {
                            root.launch-app(app.id);
                        }
                    }
                }
            }
        }

        Rectangle {
            width: root.micro ? 100px : root.phone ? 112px : root.compact ? 208px : 292px;
            height: parent.height;
            background: transparent;

            Rectangle {
                width: parent.width;
                height: root.phone ? 36px : 40px;
                x: 0px;
                y: (parent.height - self.height) / 2;
                background: #101823bb;
                border-radius: 16px;
                border-width: 1px;
                border-color: #ffffff22;
                clip: true;

                HorizontalLayout {
                    padding-left: root.phone ? 4px : 6px;
                    padding-right: root.phone ? 4px : 6px;
                    spacing: 4px;
                    alignment: center;

                    if !root.compact: ShellAction {
                        label: "";
                        icon-name: "network";
                        quiet: true;
                        compact: true;
                        clicked => {
                            root.toggle-network();
                        }
                    }

                    if !root.compact: ShellAction {
                        label: "";
                        icon-name: "audio";
                        quiet: true;
                        compact: true;
                        clicked => {
                            root.toggle-mute();
                        }
                    }

                    if !root.phone: ShellAction {
                        label: root.notification-count > 0 ? root.notification-count + "" : "";
                        icon-name: "notifications";
                        active: root.show-notifications;
                        quiet: true;
                        compact: true;
                        clicked => {
                            root.toggle-notifications();
                        }
                    }

                    ShellAction {
                        label: "";
                        icon-name: "settings";
                        active: root.show-system-center;
                        quiet: true;
                        compact: true;
                        tiny: root.phone;
                        clicked => {
                            root.toggle-system-center();
                        }
                    }

                    ShellPill {
                        label: root.clock-text;
                        tone: ShellTheme.surface-accent;
                        compact: true;
                        tiny: root.phone;
                    }
                }
            }
        }
    }
}
