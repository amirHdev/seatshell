export global ShellTheme {
    in property <color> background: #070b10;
    in property <color> background-elevated: #0d1520;
    in property <color> background-veil: #050a10cc;

    in property <color> surface: #101823cc;
    in property <color> surface-muted: #182232cc;
    in property <color> surface-strong: #202c3dcc;
    in property <color> surface-accent: #2c1d12cc;
    in property <color> surface-glow: #16283acc;

    in property <color> outline: #ffffff18;
    in property <color> outline-strong: #ffffff30;

    in property <color> text-primary: #f4efe8;
    in property <color> text-secondary: #b8c0cc;
    in property <color> text-muted: #7d8897;
    in property <color> text-accent: #ffc98b;

    in property <color> accent: #ffb36a;
    in property <color> accent-soft: #3a2618;

    in property <color> ambient-primary: #18314f;
    in property <color> ambient-secondary: #3d241b;
    in property <color> ambient-tertiary: #10283a;

    in property <color> success: #60d2aa;
    in property <color> warning: #f0c06c;

    in property <int> space-xs: 6;
    in property <int> space-sm: 10;
    in property <int> space-md: 14;
    in property <int> space-lg: 20;
    in property <int> space-xl: 28;

    in property <int> radius-sm: 6;
    in property <int> radius-md: 8;
    in property <int> radius-lg: 12;
    in property <int> radius-xl: 18;
}
