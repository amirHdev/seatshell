export component ShellAction inherits Rectangle {
    in property <string> label;
    in property <string> icon-text: "";
    in property <string> icon-name: "";
    in property <bool> active: false;
    in property <bool> quiet: false;
    in property <bool> compact: false;
    in property <bool> tiny: false;
    in property <bool> fill: false;

    callback clicked();

    width: root.label == ""
        ? (root.tiny ? 28px : root.compact ? 34px : 40px)
        : max(
            root.tiny ? 46px : root.compact ? 66px : 96px,
            label-metrics.preferred-width + (root.tiny ? 16px : root.compact ? 24px : 32px)
        );

    height: root.tiny ? 28px : root.compact ? 32px : 36px;
    horizontal-stretch: root.fill ? 1 : 0;
    border-radius: root.tiny ? 8px : root.compact ? 10px : 12px;
    border-width: root.quiet && !root.active && !touch.has-hover ? 0px : 1px;
    border-color: root.active ? ShellTheme.accent : touch.has-hover ? ShellTheme.outline-strong : ShellTheme.outline;

    background: root.active
        ? ShellTheme.surface-accent
        : touch.has-hover
            ? ShellTheme.surface-glow
            : root.quiet
                ? transparent
                : ShellTheme.surface;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    label-metrics := Text {
        text: root.label;
        font-size: root.tiny ? 9px : 11px;
        font-weight: root.active ? 700 : 600;
        visible: false;
    }

    HorizontalLayout {
        padding-left: root.tiny ? 5px : root.compact ? 8px : 11px;
        padding-right: root.tiny ? 5px : root.compact ? 8px : 11px;
        spacing: root.tiny ? 4px : 7px;
        alignment: center;

        if root.icon-text != "" || root.icon-name != "": Rectangle {
            width: root.tiny ? 16px : root.compact ? 18px : 20px;
            height: root.tiny ? 16px : root.compact ? 18px : 20px;
            border-radius: root.tiny ? 5px : 6px;
            background: root.active ? ShellTheme.accent : #ffffff10;
            border-width: 1px;
            border-color: root.active ? ShellTheme.accent : #ffffff1c;

            if root.icon-name != "": ShellIcon {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                name: root.icon-name;
                icon-color: root.active ? #1a120d : ShellTheme.text-primary;
            }

            if root.icon-name == "": Text {
                text: root.icon-text;
                color: root.active ? #1a120d : ShellTheme.text-primary;
                font-size: root.tiny ? 8px : 9px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.label != "": Text {
            text: root.label;
            color: root.active ? ShellTheme.text-primary : ShellTheme.text-secondary;
            font-size: root.tiny ? 9px : 11px;
            font-weight: root.active ? 700 : 600;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: root.fill ? 1 : 0;
        }
    }
}

export component ShellPill inherits Rectangle {
    in property <string> label;
    in property <color> tone: ShellTheme.surface-strong;
    in property <bool> compact: false;
    in property <bool> tiny: false;

    width: max(
        root.tiny ? 34px : root.compact ? 48px : 68px,
        label-metrics.preferred-width + (root.tiny ? 10px : root.compact ? 16px : 22px)
    );

    height: root.tiny ? 22px : root.compact ? 24px : 28px;
    border-radius: root.tiny ? 8px : root.compact ? 9px : 10px;
    background: root.tone;
    border-width: 1px;
    border-color: ShellTheme.outline;

    label-metrics := Text {
        text: root.label;
        font-size: root.tiny ? 8px : 10px;
        font-weight: 700;
        visible: false;
    }

    Text {
        text: root.label;
        color: ShellTheme.text-secondary;
        font-size: root.tiny ? 8px : 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component DockItem inherits Rectangle {
    in property <string> label;
    in property <string> icon-text;
    in property <string> icon-name: "";
    in property <image> icon;
    in property <bool> active: false;
    in property <int> running-count: 0;
    in property <bool> compact: false;
    in property <bool> tiny: false;

    callback clicked();

    width: root.label == ""
        ? (root.tiny ? 34px : root.compact ? 38px : 46px)
        : max(
            root.tiny ? 72px : root.compact ? 88px : 104px,
            label-metrics.preferred-width + (root.tiny ? 28px : 38px)
        );

    height: root.tiny ? 34px : root.compact ? 38px : 44px;
    border-radius: root.tiny ? 10px : ShellTheme.radius-lg * 1px;
    border-width: root.active || touch.has-hover ? 1px : 0px;
    border-color: root.active ? ShellTheme.accent : ShellTheme.outline-strong;

    background: touch.has-hover
        ? ShellTheme.surface-glow
        : root.active
            ? ShellTheme.surface-accent
            : transparent;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    label-metrics := Text {
        text: root.label;
        font-size: root.tiny ? 9px : 11px;
        font-weight: 700;
        visible: false;
    }

    HorizontalLayout {
        padding-left: root.tiny ? 6px : 8px;
        padding-right: root.tiny ? 6px : 8px;
        spacing: root.tiny ? 4px : 6px;
        alignment: center;

        Rectangle {
            width: root.tiny ? 22px : root.compact ? 24px : 26px;
            height: root.tiny ? 22px : root.compact ? 24px : 26px;
            border-radius: root.tiny ? 5px : 6px;
            background: root.active ? ShellTheme.accent : #ffffff10;
            border-width: 1px;
            border-color: root.active ? ShellTheme.accent : #ffffff20;

            if root.icon.width > 0 && root.icon.height > 0: Image {
                source: root.icon;
                width: root.tiny ? 12px : 14px;
                height: root.tiny ? 12px : 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if (root.icon.width == 0 || root.icon.height == 0) && root.icon-name != "": ShellIcon {
                x: 5px;
                y: 5px;
                width: parent.width - 10px;
                height: parent.height - 10px;
                name: root.icon-name;
                icon-color: root.active ? #1a120d : ShellTheme.text-primary;
            }

            if (root.icon.width == 0 || root.icon.height == 0) && root.icon-name == "": Text {
                text: root.icon-text;
                color: root.active ? #1a120d : ShellTheme.text-primary;
                font-size: root.tiny ? 9px : 10px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.label != "": Text {
            text: root.label;
            color: ShellTheme.text-primary;
            font-size: root.tiny ? 9px : 11px;
            font-weight: 700;
            overflow: elide;
        }

        if root.running-count > 1: Rectangle {
            width: 18px;
            height: 14px;
            border-radius: 999px;
            background: ShellTheme.accent;
            border-width: 1px;
            border-color: ShellTheme.accent;

            Text {
                text: root.running-count + "";
                color: #1a120d;
                font-size: 9px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if root.active || root.running-count > 0: Rectangle {
        width: root.running-count > 1 ? 18px : 8px;
        height: 3px;
        y: parent.height - 5px;
        x: (parent.width - self.width) / 2;
        border-radius: 999px;
        background: ShellTheme.accent;
    }
}
