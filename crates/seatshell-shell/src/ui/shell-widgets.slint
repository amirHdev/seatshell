import { ShellTheme } from "shell-theme.slint";

export component ShellIcon inherits Rectangle {
    in property <string> name;
    in property <color> icon-color: ShellTheme.text-primary;

    background: transparent;

    if root.name == "brand" || root.name == "apps": Rectangle {
        x: parent.width * 0.16;
        y: parent.height * 0.16;
        width: parent.width * 0.28;
        height: parent.height * 0.28;
        background: root.icon-color;
        border-radius: 2px;
