        y: parent.height * 0.04;
        width: parent.width * 0.12;
        height: parent.height * 0.26;
        background: root.icon-color;
        border-radius: 2px;
    }

    if root.name == "settings": Rectangle {
        x: parent.width * 0.44;
        y: parent.height * 0.7;
        width: parent.width * 0.12;
        height: parent.height * 0.26;
        background: root.icon-color;
        border-radius: 2px;
    }

