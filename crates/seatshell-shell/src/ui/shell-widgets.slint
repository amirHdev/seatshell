        y: parent.height * 0.44;
        width: parent.width * 0.26;
        height: parent.height * 0.12;
        background: root.icon-color;
        border-radius: 2px;
    }

    if root.name == "settings": Rectangle {
        x: parent.width * 0.7;
        y: parent.height * 0.44;
        width: parent.width * 0.26;
        height: parent.height * 0.12;
        background: root.icon-color;
        border-radius: 2px;
    }

    if root.name == "power": Rectangle {
        x: parent.width * 0.16;
        y: parent.height * 0.2;
        width: parent.width * 0.68;
        height: parent.height * 0.68;
        background: transparent;
        border-width: 2px;
        border-color: root.icon-color;
        border-radius: 999px;
    }

    if root.name == "power": Rectangle {
        x: parent.width * 0.43;
        y: parent.height * 0.02;
        width: parent.width * 0.14;
        height: parent.height * 0.54;
        background: root.icon-color;
        border-radius: 999px;
    }

    if root.name == "brightness": Rectangle {
        x: parent.width * 0.34;
        y: parent.height * 0.34;
        width: parent.width * 0.32;
