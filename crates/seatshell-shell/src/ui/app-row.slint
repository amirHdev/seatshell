import { ShellTheme } from "shell-theme.slint";

export component AppRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;
    in property <string> icon-text;
    in property <image> icon;
    in property <string> accent: "#4a90e2";
    in property <bool> selected: false;
    in property <bool> favorite: false;
    in property <int> running-count: 0;
    in property <bool> show-favorite-toggle: false;
    in property <bool> compact: false;
    in property <bool> tiny: false;

    callback clicked();
    callback toggle-favorite();

    height: root.tiny ? 46px : root.compact ? 52px : 58px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: root.compact ? 11px : 14px;
    border-width: root.selected || touch.has-hover ? 1px : 0px;
    border-color: root.selected ? ShellTheme.accent : ShellTheme.outline;
    background: root.selected
        ? ShellTheme.surface-accent
        : touch.has-hover
            ? #ffffff0d
            : transparent;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: root.tiny ? 7px : root.compact ? 9px : 12px;
        padding-right: root.tiny ? 7px : root.compact ? 9px : 12px;
        spacing: root.tiny ? 7px : root.compact ? 9px : 12px;
        alignment: start;

        Rectangle {
            width: root.tiny ? 28px : root.compact ? 32px : 38px;
            height: root.tiny ? 28px : root.compact ? 32px : 38px;
            background: root.selected || touch.has-hover ? ShellTheme.accent : #ffffff10;
            border-radius: 999px;
            border-width: 1px;
            border-color: root.selected || touch.has-hover ? ShellTheme.accent : #ffffff20;

            if root.icon.width > 0 && root.icon.height > 0: Image {
                source: root.icon;
                width: root.tiny ? 16px : root.compact ? 18px : 22px;
                height: root.tiny ? 16px : root.compact ? 18px : 22px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if root.icon.width == 0 || root.icon.height == 0: Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.icon-text;
                color: root.selected || touch.has-hover ? #1a120d : ShellTheme.text-primary;
                font-size: root.tiny ? 9px : root.compact ? 10px : 12px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        VerticalLayout {
            height: root.tiny ? 28px : root.compact ? 34px : 40px;
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                color: ShellTheme.text-primary;
                font-size: root.tiny ? 11px : root.compact ? 12px : 13px;
                font-weight: 800;
                overflow: elide;
                horizontal-stretch: 1;
            }

            if !root.tiny: Text {
                text: root.detail;
                color: ShellTheme.text-muted;
                font-size: root.compact ? 10px : 11px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        if root.running-count > 0: Rectangle {
            width: root.running-count > 1 ? (root.tiny ? 18px : 22px) : 8px;
            height: root.running-count > 1 ? (root.tiny ? 16px : 18px) : 8px;
            background: root.running-count > 1 ? ShellTheme.accent : ShellTheme.text-muted;
            border-radius: 999px;

            if root.running-count > 1: Text {
                text: root.running-count + "";
                color: #1a120d;
                font-size: 9px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        if root.show-favorite-toggle: Rectangle {
            width: root.tiny ? 34px : root.compact ? 44px : 50px;
            height: root.tiny ? 24px : root.compact ? 26px : 28px;
            background: root.favorite ? ShellTheme.surface-accent : #ffffff0d;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.favorite ? ShellTheme.accent : #ffffff22;

            pin-touch := TouchArea {
                clicked => {
                    root.toggle-favorite();
                }
            }

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.favorite ? "On" : "Pin";
                color: root.favorite ? ShellTheme.text-accent : ShellTheme.text-secondary;
                font-size: root.tiny ? 8px : 10px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
