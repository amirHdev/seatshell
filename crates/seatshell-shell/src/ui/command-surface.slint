import { LauncherApp } from "launcher.slint";
import { AppRow } from "app-row.slint";
import { ShellTheme } from "shell-theme.slint";
import { ShellAction, ShellPill } from "shell-widgets.slint";
import { ScrollView } from "std-widgets.slint";

export component CommandSurface inherits Rectangle {
    in property <string> accent: "#4a90e2";
    in property <bool> overview-enabled: true;
    in property <[LauncherApp]> featured-apps;
    in property <[LauncherApp]> recent-apps;
    in property <bool> compact: root.width < 420px || root.height < 460px;

    callback close();
    callback show-launcher();
    callback show-overview();
    callback launch-app(string);

    background: ShellTheme.background-veil;

    touch := TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        width: min(root.width - 24px, 440px);
        height: min(root.height - 24px, 520px);
        x: max(12px, (root.width - self.width) / 2);
        y: max(12px, (root.height - self.height) / 2);
        background: ShellTheme.background-elevated;
        border-radius: ShellTheme.radius-xl * 1px;
        border-width: 1px;
        border-color: ShellTheme.outline;

        VerticalLayout {
            padding: root.compact ? 12px : 16px;
            spacing: root.compact ? 8px : 12px;

            HorizontalLayout {
                spacing: 8px;
                alignment: center;

                VerticalLayout {
                    spacing: 2px;
                    horizontal-stretch: 1;

                    Text {
                        text: "Quick access";
                        color: ShellTheme.text-primary;
                        font-size: 18px;
                        font-weight: 800;
                    }

                    if !root.compact: Text {
                        text: "Pinned and recent applications.";
                        color: ShellTheme.text-secondary;
                        font-size: 12px;
                    }
                }

                if !root.compact: ShellPill {
                    label: "Shortcuts";
                    compact: true;
                }

                ShellAction {
                    label: root.compact ? "" : "Close";
                    icon-name: "close";
                    compact: true;
                    clicked => {
                        root.close();
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: ShellTheme.outline;
            }

            HorizontalLayout {
                spacing: 8px;

                ShellAction {
                    label: "Launcher";
                    icon-name: "apps";
                    compact: true;
                    fill: true;
                    clicked => {
                        root.show-launcher();
                    }
                }

                if root.overview-enabled: ShellAction {
                    label: "Overview";
                    icon-name: "sessions";
                    compact: true;
                    fill: true;
                    clicked => {
                        root.show-overview();
                    }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;

                VerticalLayout {
                    spacing: 14px;

                    if root.featured-apps.length > 0: Rectangle {
                        background: transparent;

                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Pinned";
                                color: ShellTheme.text-secondary;
                                font-size: 12px;
                                font-weight: 700;
                            }

                            for app in root.featured-apps: AppRow {
                                name: app.name;
                                detail: app.detail;
                                icon-text: app.icon_text;
                                icon: app.icon;
                                favorite: app.favorite;
                                accent: root.accent;
                                compact: root.compact;
                                tiny: root.width < 360px;
                                clicked => {
                                    root.launch-app(app.id);
                                }
                            }
                        }
                    }

                    if root.recent-apps.length > 0: Rectangle {
                        background: transparent;

                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Recent";
                                color: ShellTheme.text-secondary;
                                font-size: 12px;
                                font-weight: 700;
                            }

                            for app in root.recent-apps: AppRow {
                                name: app.name;
                                detail: app.detail;
                                icon-text: app.icon_text;
                                icon: app.icon;
                                favorite: app.favorite;
                                accent: root.accent;
                                compact: root.compact;
                                tiny: root.width < 360px;
                                clicked => {
                                    root.launch-app(app.id);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
