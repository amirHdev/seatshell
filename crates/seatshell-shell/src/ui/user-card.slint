import { ShellTheme } from "shell-theme.slint";
import { ShellIcon, ShellPill } from "shell-widgets.slint";

export component UserCard inherits Rectangle {
    in property <string> username;
    in property <string> state;
    in property <string> action;
    in property <string> accent: "#4a90e2";
    in property <bool> selected: false;
    in property <bool> locked: false;
    in property <bool> current: false;
    in property <bool> compact: false;
    in property <bool> tiny: false;

    height: root.tiny ? 70px : root.compact ? 82px : 96px;
    background: root.selected
        ? ShellTheme.surface-accent
        : root.current
            ? ShellTheme.surface-glow
            : ShellTheme.surface;
    border-radius: ShellTheme.radius-lg * 1px;
    border-width: 1px;
    border-color: root.selected || root.current
        ? ShellTheme.accent
        : root.locked
            ? ShellTheme.warning
            : ShellTheme.outline;
    horizontal-stretch: 1;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    HorizontalLayout {
        padding: root.tiny ? 8px : root.compact ? 10px : ShellTheme.space-md * 1px;
        spacing: root.tiny ? 7px : ShellTheme.space-sm * 1px;
        alignment: center;

        Rectangle {
            width: root.tiny ? 32px : root.compact ? 38px : 44px;
            height: root.tiny ? 32px : root.compact ? 38px : 44px;
            background: root.selected || root.current
                ? ShellTheme.accent
                : root.locked
                    ? ShellTheme.surface-accent
                    : ShellTheme.surface-muted;
            border-radius: 999px;
            border-width: 1px;
            border-color: root.selected || root.current
                ? ShellTheme.accent
                : root.locked
                    ? ShellTheme.warning
                    : ShellTheme.outline;

            ShellIcon {
                width: root.tiny ? 16px : 20px;
                height: root.tiny ? 16px : 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                name: root.locked ? "lock" : "user";
                icon-color: root.selected || root.current ? #1a120d : ShellTheme.text-primary;
            }
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.username;
                color: ShellTheme.text-primary;
                font-size: root.tiny ? 12px : root.compact ? 14px : 15px;
                font-weight: 800;
            }

            if !root.tiny: Text {
                text: root.state;
                color: ShellTheme.text-secondary;
                font-size: root.compact ? 11px : 12px;
                overflow: elide;
            }

            ShellPill {
                label: root.current ? "Current session" : root.locked ? "Locked session" : root.action;
                tone: root.current
                    ? ShellTheme.surface-glow
                    : root.locked
                        ? ShellTheme.surface-accent
                        : ShellTheme.surface-strong;
                compact: true;
                tiny: root.tiny;
            }
        }
    }
}
