import { LauncherApp } from "launcher.slint";
import { ShellTheme } from "shell-theme.slint";
import { ShellAction, ShellIcon, ShellPill } from "shell-widgets.slint";
import { ScrollView } from "std-widgets.slint";

export struct DesktopFile {
    path: string,
    name: string,
    detail: string,
}

export struct DesktopShortcutEntry {
    id: string,
    name: string,
    icon_text: string,
    icon: image,
    active: bool,
    selected: bool,
    x: int,
    y: int,
}

export struct DesktopWindowEntry {
    id: string,
    name: string,
    detail: string,
    icon_text: string,
    icon: image,
    focused: bool,
    minimized: bool,
    maximized: bool,
    x: int,
    y: int,
    width: int,
    height: int,
}

component DesktopShortcut inherits Rectangle {
    in property <string> app-id;
    in property <string> label;
    in property <string> icon-text;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> selected: false;
    in property <bool> draggable: false;
    in property <bool> compact: false;
    in property <int> max-x: 9999;
    in property <int> max-y: 9999;

    in-out property <length> drag-offset-x: 0px;
    in-out property <length> drag-offset-y: 0px;
    in-out property <length> drag-start-x: 0px;
    in-out property <length> drag-start-y: 0px;
    out property <bool> dragging: root.drag-offset-x > 6px
        || root.drag-offset-x < -6px
        || root.drag-offset-y > 6px
        || root.drag-offset-y < -6px;

    callback activated();
    callback selection-requested(string);
    callback moved(string, int, int, int, int);

    width: root.compact ? 92px : 108px;
    height: root.compact ? 96px : 112px;
    background: root.dragging
        ? #263a52d9
        : touch.has-hover || root.selected || root.active
            ? #101823cc
            : transparent;
    border-radius: 14px;
    border-width: touch.has-hover || root.selected || root.active ? 1px : 0px;
    border-color: root.selected || root.active ? ShellTheme.accent : #ffffff22;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: root.draggable ? (self.pressed ? grabbing : grab) : default;

        moved => {
            if root.draggable && self.pressed {
                root.drag-offset-x = root.x + self.mouse-x - self.pressed-x - root.drag-start-x;
                root.drag-offset-y = root.y + self.mouse-y - self.pressed-y - root.drag-start-y;
            }
        }

        pointer-event(event) => {
            if !root.draggable || event.button != PointerEventButton.left {
                return;
            }

            if event.kind == PointerEventKind.down {
                root.drag-start-x = root.x;
                root.drag-start-y = root.y;
            } else if event.kind == PointerEventKind.up {
                if root.drag-offset-x > 6px || root.drag-offset-x < -6px || root.drag-offset-y > 6px || root.drag-offset-y < -6px {
                    root.moved(
                        root.app-id,
                        min(max((root.x / 1px), 0), root.max-x),
                        min(max((root.y / 1px), 0), root.max-y),
                        root.max-x,
                        root.max-y
                    );
                    root.selection-requested(root.app-id);
                } else {
                    root.selection-requested(root.app-id);
                }

                root.drag-offset-x = 0px;
                root.drag-offset-y = 0px;
                root.drag-start-x = 0px;
                root.drag-start-y = 0px;
            }
        }

        clicked => {
            if !root.draggable {
                root.activated();
            }
        }

        double-clicked => {
            root.activated();
        }
    }

    if root.dragging: Rectangle {
        x: 8px;
        y: parent.height - 24px;
        width: parent.width - 16px;
        height: 18px;
        background: ShellTheme.surface-accent;
        border-radius: 7px;
        border-width: 1px;
        border-color: ShellTheme.accent;

        Text {
            text: "SNAP";
            color: ShellTheme.text-accent;
            font-size: 8px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    VerticalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        spacing: 0px;
        alignment: start;

        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }

        VerticalLayout {
            width: parent.width;
            height: root.compact ? 78px : 90px;
            spacing: root.compact ? 6px : 8px;
            alignment: start;

            Rectangle {
                width: parent.width;
                height: root.compact ? 48px : 54px;
                background: transparent;

                Rectangle {
                    width: root.compact ? 48px : 54px;
                    height: root.compact ? 48px : 54px;
                    x: (parent.width - self.width) / 2;
                    y: 0px;
                    background: root.active ? #33271ed9 : #101823d9;
                    border-radius: 14px;
                    border-width: 1px;
                    border-color: root.active ? ShellTheme.accent : #ffffff28;

                    if root.icon.width > 0 && root.icon.height > 0: Image {
                        source: root.icon;
                        width: root.compact ? 28px : 32px;
                        height: root.compact ? 28px : 32px;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        image-fit: contain;
                    }

                    if root.icon.width == 0 || root.icon.height == 0: Text {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        text: root.icon-text;
                        color: root.active ? ShellTheme.text-accent : ShellTheme.text-primary;
                        font-size: root.compact ? 11px : 13px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.label;
                width: parent.width - 8px;
                height: root.compact ? 24px : 28px;
                horizontal-alignment: center;
                color: ShellTheme.text-primary;
                font-size: root.compact ? 10px : 11px;
                font-weight: 600;
                vertical-alignment: center;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        Rectangle {
            background: transparent;
            vertical-stretch: 1;
        }
    }
}

component WorkspaceWindow inherits Rectangle {
    in property <string> app-id;
    in property <string> title;
    in property <string> detail;
    in property <string> icon-text;
    in property <image> icon;
    in property <bool> focused: false;
    in property <bool> minimized: false;
    in property <bool> maximized: false;
    in property <int> max-x: 9999;
    in property <int> max-y: 9999;

    in-out property <length> drag-offset-x: 0px;
    in-out property <length> drag-offset-y: 0px;
    in-out property <length> resize-offset-x: 0px;
    in-out property <length> resize-offset-y: 0px;
    in-out property <length> drag-start-x: 0px;
    in-out property <length> drag-start-y: 0px;
    in-out property <length> resize-start-width: 0px;
    in-out property <length> resize-start-height: 0px;

    callback focus-requested(string);
    callback minimized-requested(string);
    callback maximized-requested(string);
    callback closed-requested(string);
    callback moved(string, int, int, int, int);
    callback resized(string, int, int);

    visible: !root.minimized;
    min-width: 280px;
    min-height: 240px;
    background: root.focused ? #101927f6 : #0c1420ee;
    border-radius: 18px;
    border-width: 1px;
    border-color: root.focused ? ShellTheme.accent : #ffffff22;
    clip: true;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    titlebar := Rectangle {
        height: 0px;
        width: parent.width;
        background: transparent;

        drag-touch := TouchArea {
            mouse-cursor: self.pressed ? grabbing : grab;

            pointer-event(event) => {
                if event.button != PointerEventButton.left {
                    return;
                }

                if event.kind == PointerEventKind.down {
                    root.focus-requested(root.app-id);
                    root.drag-start-x = root.x;
                    root.drag-start-y = root.y;
                } else if event.kind == PointerEventKind.up {
                    if root.drag-offset-x > 3px || root.drag-offset-x < -3px || root.drag-offset-y > 3px || root.drag-offset-y < -3px {
                        root.moved(
                            root.app-id,
                            min(max((root.x / 1px), 0), root.max-x),
                            min(max((root.y / 1px), 0), root.max-y),
                            root.max-x,
                            root.max-y
                        );
                    }

                    root.drag-offset-x = 0px;
                    root.drag-offset-y = 0px;
                    root.drag-start-x = 0px;
                    root.drag-start-y = 0px;
                }
            }

            moved => {
                if self.pressed {
                    root.drag-offset-x = root.x + self.mouse-x - self.pressed-x - root.drag-start-x;
                    root.drag-offset-y = root.y + self.mouse-y - self.pressed-y - root.drag-start-y;
                }
            }
        }

        Rectangle {
            x: 11px;
            y: 9px;
            width: 24px;
            height: 24px;
            background: root.focused ? ShellTheme.accent : #ffffff12;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.focused ? ShellTheme.accent : #ffffff20;

            if root.icon.width > 0 && root.icon.height > 0: Image {
                source: root.icon;
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }

            if root.icon.width == 0 || root.icon.height == 0: Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: root.icon-text;
                color: root.focused ? #1a120d : ShellTheme.text-primary;
                font-size: 9px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Text {
            x: 44px;
            y: 0px;
            width: parent.width - 112px;
            height: parent.height;
            text: root.title;
            color: ShellTheme.text-primary;
            font-size: 12px;
            font-weight: 800;
            overflow: elide;
            vertical-alignment: center;
        }

        Rectangle {
            x: parent.width - 62px;
            y: 9px;
            width: 24px;
            height: 24px;
            background: minimize-touch.has-hover ? #ffffff16 : transparent;
            border-radius: 8px;

            minimize-touch := TouchArea {
                clicked => {
                    root.minimized-requested(root.app-id);
                }
            }

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: "-";
                color: ShellTheme.text-secondary;
                font-size: 15px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            x: parent.width - 34px;
            y: 9px;
            width: 24px;
            height: 24px;
            background: close-touch.has-hover ? #9b2f2fbb : transparent;
            border-radius: 8px;

            close-touch := TouchArea {
                clicked => {
                    root.closed-requested(root.app-id);
                }
            }

            Text {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                text: "X";
                color: close-touch.has-hover ? #ffffff : ShellTheme.text-secondary;
                font-size: 11px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            y: 0px;
            width: parent.width;
            height: 0px;
            background: transparent;
        }
    }

    body-touch := TouchArea {
        y: 0px;
        width: parent.width;
        height: parent.height;

        clicked => {
            root.focus-requested(root.app-id);
        }
    }

    Rectangle {
        x: 14px;
        y: 14px;
        width: parent.width - 28px;
        height: parent.height - 28px;
        background: #070d15;
        border-radius: 13px;
        border-width: 1px;
        border-color: #ffffff16;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 10px;

            header := Rectangle {
                height: 42px;
                background: transparent;

                header-touch := TouchArea {
                    mouse-cursor: root.maximized ? default : (self.pressed ? grabbing : grab);

                    pointer-event(event) => {
                        if event.button != PointerEventButton.left {
                            return;
                        }

                        if event.kind == PointerEventKind.down {
                            root.focus-requested(root.app-id);
                            root.drag-start-x = root.x;
                            root.drag-start-y = root.y;
                        } else if event.kind == PointerEventKind.up {
                            if !root.maximized
                                && (root.drag-offset-x > 3px || root.drag-offset-x < -3px || root.drag-offset-y > 3px || root.drag-offset-y < -3px) {
                                root.moved(
                                    root.app-id,
                                    min(max((root.x / 1px), 0), root.max-x),
                                    min(max((root.y / 1px), 0), root.max-y),
                                    root.max-x,
                                    root.max-y
                                );
                            }

                            root.drag-offset-x = 0px;
                            root.drag-offset-y = 0px;
                            root.drag-start-x = 0px;
                            root.drag-start-y = 0px;
                        }
                    }

                    moved => {
                        if self.pressed && !root.maximized {
                            root.drag-offset-x = root.x + self.mouse-x - self.pressed-x - root.drag-start-x;
                            root.drag-offset-y = root.y + self.mouse-y - self.pressed-y - root.drag-start-y;
                        }
                    }
                }

                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    spacing: 8px;
                    alignment: center;

                    Rectangle {
                        width: 38px;
                        height: 38px;
                        background: ShellTheme.surface-accent;
                        border-radius: 12px;
                        border-width: 1px;
                        border-color: ShellTheme.accent;

                        if root.icon.width > 0 && root.icon.height > 0: Image {
                            source: root.icon;
                            width: 22px;
                            height: 22px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }

                        if root.icon.width == 0 || root.icon.height == 0: Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: root.icon-text;
                            color: ShellTheme.text-accent;
                            font-size: 11px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 2px;
                        horizontal-stretch: 1;

                        Text {
                            text: root.title;
                            color: ShellTheme.text-primary;
                            font-size: 14px;
                            font-weight: 900;
                            overflow: elide;
                        }

                        Text {
                            text: root.detail;
                            color: ShellTheme.text-muted;
                            font-size: 10px;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        background: visible-minimize-touch.has-hover ? #ffffff16 : #ffffff0a;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: #ffffff18;

                        visible-minimize-touch := TouchArea {
                            clicked => {
                                root.minimized-requested(root.app-id);
                            }
                        }

                        Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: "-";
                            color: ShellTheme.text-secondary;
                            font-size: 15px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        background: visible-maximize-touch.has-hover ? #ffffff16 : #ffffff0a;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: root.maximized ? ShellTheme.accent : #ffffff18;

                        visible-maximize-touch := TouchArea {
                            clicked => {
                                root.maximized-requested(root.app-id);
                            }
                        }

                        Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: root.maximized ? "<>" : "+";
                            color: root.maximized ? ShellTheme.text-accent : ShellTheme.text-secondary;
                            font-size: 12px;
                            font-weight: 900;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        background: visible-close-touch.has-hover ? #9b2f2fbb : #ffffff0a;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: visible-close-touch.has-hover ? #9b2f2f : #ffffff18;

                        visible-close-touch := TouchArea {
                            clicked => {
                                root.closed-requested(root.app-id);
                            }
                        }

                        Text {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: "X";
                            color: visible-close-touch.has-hover ? #ffffff : ShellTheme.text-secondary;
                            font-size: 11px;
                            font-weight: 800;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: 34px;
                background: #ffffff08;
                border-radius: 10px;
                border-width: 1px;
                border-color: #ffffff14;

                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 7px;
                    alignment: center;

                    Rectangle { width: 9px; height: 9px; border-radius: 999px; background: #ff7a6a; }
                    Rectangle { width: 9px; height: 9px; border-radius: 999px; background: #f4c76a; }
                    Rectangle { width: 9px; height: 9px; border-radius: 999px; background: #6cd69a; }
                    Rectangle { horizontal-stretch: 1; height: 8px; background: #ffffff12; border-radius: 999px; }
                    Rectangle { width: 54px; height: 8px; background: #ffffff18; border-radius: 999px; }
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 10px;

                Rectangle {
                    width: 112px;
                    background: #ffffff08;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #ffffff12;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        Rectangle { height: 8px; background: ShellTheme.accent; border-radius: 999px; }
                        Rectangle { height: 8px; background: #ffffff1c; border-radius: 999px; }
                        Rectangle { height: 8px; background: #ffffff14; border-radius: 999px; }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                        Rectangle { height: 28px; background: #ffffff10; border-radius: 9px; }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: #ffffff06;
                    border-radius: 12px;
                    border-width: 1px;
                    border-color: #ffffff10;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 9px;

                        Rectangle { height: 11px; horizontal-stretch: 1; background: #ffffff28; border-radius: 999px; }
                        Rectangle { height: 9px; horizontal-stretch: 1; background: #ffffff16; border-radius: 999px; }
                        Rectangle { height: 9px; horizontal-stretch: 1; background: #ffffff14; border-radius: 999px; }

                        HorizontalLayout {
                            spacing: 8px;
                            Rectangle { horizontal-stretch: 1; height: 68px; background: #ffffff0d; border-radius: 10px; }
                            Rectangle { horizontal-stretch: 1; height: 68px; background: #ffffff0d; border-radius: 10px; }
                        }

                        Rectangle { vertical-stretch: 1; background: #ffffff08; border-radius: 10px; }
                    }
                }
            }
        }
    }

    if !root.maximized: Rectangle {
        x: parent.width - 24px;
        y: parent.height - 24px;
        width: 24px;
        height: 24px;
        background: resize-touch.has-hover ? #ffffff18 : transparent;
        border-radius: 8px;

        resize-touch := TouchArea {
            mouse-cursor: nwse-resize;

            pointer-event(event) => {
                if event.button != PointerEventButton.left {
                    return;
                }

                if event.kind == PointerEventKind.down {
                    root.focus-requested(root.app-id);
                    root.resize-start-width = root.width;
                    root.resize-start-height = root.height;
                } else if event.kind == PointerEventKind.up {
                    root.resized(
                        root.app-id,
                        max(((root.width + root.resize-offset-x) / 1px), 280),
                        max(((root.height + root.resize-offset-y) / 1px), 240)
                    );
                    root.resize-offset-x = 0px;
                    root.resize-offset-y = 0px;
                    root.resize-start-width = 0px;
                    root.resize-start-height = 0px;
                }
            }

            moved => {
                if self.pressed {
                    root.resize-offset-x = root.width + self.mouse-x - self.pressed-x - root.resize-start-width;
                    root.resize-offset-y = root.height + self.mouse-y - self.pressed-y - root.resize-start-height;
                }
            }
        }

        Rectangle {
            x: 8px;
            y: 14px;
            width: 10px;
            height: 1px;
            background: ShellTheme.text-muted;
        }

        Rectangle {
            x: 12px;
            y: 18px;
            width: 7px;
            height: 1px;
            background: ShellTheme.text-muted;
        }
    }
}

component RecentFileRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;

    callback clicked();
    callback reveal-clicked();

    height: 38px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    background: touch.has-hover ? #ffffff0f : transparent;
    border-radius: 9px;

    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        padding-left: 6px;
        padding-right: 6px;
        spacing: 9px;
        alignment: center;

        Rectangle {
            width: 24px;
            height: 24px;
            background: #ffffff10;
            border-radius: 7px;
            border-width: 1px;
            border-color: #ffffff22;

            ShellIcon {
                x: 6px;
                y: 6px;
                width: 12px;
                height: 12px;
                name: "file";
                icon-color: ShellTheme.text-secondary;
            }
        }

        VerticalLayout {
            height: 28px;
            spacing: 0px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                color: ShellTheme.text-primary;
                font-size: 10px;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Text {
                text: root.detail;
                color: ShellTheme.text-muted;
                font-size: 9px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        Rectangle {
            width: 26px;
            height: 26px;
            background: reveal-touch.has-hover ? #ffffff16 : #ffffff08;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ffffff20;

            ShellIcon {
                x: 7px;
                y: 7px;
                width: 12px;
                height: 12px;
                name: "file";
                icon-color: ShellTheme.text-secondary;
            }

            reveal-touch := TouchArea {
                clicked => {
                    root.reveal-clicked();
                }
            }
        }
    }
}

component DesktopContextMenu inherits Rectangle {
    callback open-applications();
    callback arrange-icons();
    callback open-command();
    callback close();

    width: 218px;
    height: 154px;
    background: #0b1420f4;
    border-radius: 13px;
    border-width: 1px;
    border-color: #ffffff28;
    clip: true;

    VerticalLayout {
        padding: 9px;
        spacing: 7px;

        ShellAction {
            label: "Applications";
            icon-name: "apps";
            compact: true;
            fill: true;
            clicked => {
                root.open-applications();
            }
        }

        ShellAction {
            label: "Arrange icons";
            icon-name: "desktop";
            compact: true;
            fill: true;
            clicked => {
                root.arrange-icons();
            }
        }

        ShellAction {
            label: "Command";
            icon-name: "command";
            compact: true;
            fill: true;
            clicked => {
                root.open-command();
            }
        }
    }
}

export component Desktop inherits Rectangle {
    in property <string> accent: "#4a90e2";
    in property <string> clock-text;
    in property <string> status-text: "Ready";
    in property <string> network-text: "NET";
    in property <string> power-text: "PWR";
    in property <string> audio-text: "VOL ?";
    in property <[LauncherApp]> apps;
    in property <[LauncherApp]> featured-apps;
    in property <[LauncherApp]> recent-apps;
    in property <[LauncherApp]> active-apps;
    in property <[DesktopWindowEntry]> desktop-windows;
    in property <[DesktopFile]> recent-files;
    in property <[DesktopShortcutEntry]> desktop-shortcuts;
    in property <string> selected-shortcut-id;
    in property <string> user-name;
    in property <string> theme-name;
    in property <image> wallpaper-image;
    in property <int> app-count;
    in property <int> session-count;
    in property <int> notification-count;
    in property <bool> overview-enabled: true;

    in property <bool> phone: root.width < 560px;
    in property <bool> tablet: root.width >= 560px && root.width < 900px;
    in property <bool> desktop: root.width >= 900px;
    in property <bool> wide: root.width >= 1180px;
    in property <bool> compact: root.width < 700px;
    in-out property <bool> context-menu-open: false;
    in-out property <length> context-menu-x: 20px;
    in-out property <length> context-menu-y: 20px;
    in-out property <length> info-widget-x: root.desktop ? root.width - (root.wide ? 346px : 322px) : 12px;
    in-out property <length> info-widget-y: root.desktop ? 32px : 12px;
    in-out property <length> files-widget-x: root.desktop ? root.width - (root.wide ? 346px : 322px) : 12px;
    in-out property <length> files-widget-y: root.desktop ? 184px : 156px;
    in-out property <length> info-widget-drag-offset-x: 0px;
    in-out property <length> info-widget-drag-offset-y: 0px;
    in-out property <length> info-widget-drag-start-x: 0px;
    in-out property <length> info-widget-drag-start-y: 0px;
    in-out property <length> files-widget-drag-offset-x: 0px;
    in-out property <length> files-widget-drag-offset-y: 0px;
    in-out property <length> files-widget-drag-start-x: 0px;
    in-out property <length> files-widget-drag-start-y: 0px;

    callback show-launcher();
    callback show-command-surface();
    callback show-overview();
    callback launch-app(string);
    callback focus-window(string);
    callback minimize-window(string);
    callback maximize-window(string);
    callback close-window(string);
    callback move-window(string, int, int, int, int);
    callback resize-window(string, int, int);
    callback open-file(string);
    callback reveal-file(string);
    callback select-desktop-shortcut(string);
    callback clear-desktop-shortcut-selection();
    callback select-all-desktop-shortcuts();
    callback marquee-select-desktop-shortcuts(int, int, int, int, int, int);
    callback move-desktop-shortcut-selection(int, int);
    callback nudge-selected-desktop-shortcuts(int, int, int, int);
    callback auto-arrange-desktop-shortcuts(int, int);
    callback move-desktop-shortcut(string, int, int, int, int);

    background: ShellTheme.background;
    forward-focus: desktop-focus;

    desktop-focus := FocusScope {
        x: 0px;
        width: 0px;

        key-pressed(event) => {
            if event.text == Key.Return {
                if root.selected-shortcut-id != "" {
                    root.launch-app(root.selected-shortcut-id);
                }
                accept
            } else if event.text == Key.Escape {
                root.clear-desktop-shortcut-selection();
                accept
            } else if event.text == "a" && event.modifiers.control && event.modifiers.shift {
                root.auto-arrange-desktop-shortcuts(lane.max-shortcut-x, lane.max-shortcut-y);
                accept
            } else if event.text == "a" && event.modifiers.control {
                root.select-all-desktop-shortcuts();
                accept
            } else if event.text == Key.LeftArrow {
                if event.modifiers.control {
                    root.nudge-selected-desktop-shortcuts(-1, 0, lane.max-shortcut-x, lane.max-shortcut-y);
                } else {
                    root.move-desktop-shortcut-selection(-1, 0);
                }
                accept
            } else if event.text == Key.RightArrow {
                if event.modifiers.control {
                    root.nudge-selected-desktop-shortcuts(1, 0, lane.max-shortcut-x, lane.max-shortcut-y);
                } else {
                    root.move-desktop-shortcut-selection(1, 0);
                }
                accept
            } else if event.text == Key.UpArrow {
                if event.modifiers.control {
                    root.nudge-selected-desktop-shortcuts(0, -1, lane.max-shortcut-x, lane.max-shortcut-y);
                } else {
                    root.move-desktop-shortcut-selection(0, -1);
                }
                accept
            } else if event.text == Key.DownArrow {
                if event.modifiers.control {
                    root.nudge-selected-desktop-shortcuts(0, 1, lane.max-shortcut-x, lane.max-shortcut-y);
                } else {
                    root.move-desktop-shortcut-selection(0, 1);
                }
                accept
            } else {
                reject
            }
        }
    }

    if root.wallpaper-image.width > 0 && root.wallpaper-image.height > 0: Image {
        source: root.wallpaper-image;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.phone ? #03070c66 : #03070c36;
    }

    desktop-touch := TouchArea {
        width: parent.width;
        height: parent.height;

        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.right {
                desktop-focus.focus();
                root.clear-desktop-shortcut-selection();
                root.context-menu-x = min(max(self.mouse-x, 8px), root.width - 226px);
                root.context-menu-y = min(max(self.mouse-y, 8px), root.height - 162px);
                root.context-menu-open = true;
            } else if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                root.context-menu-open = false;
            }
        }
    }

    Rectangle {
        x: root.phone ? -220px : -160px;
        y: root.phone ? -220px : -180px;
        width: root.phone ? 420px : 460px;
        height: root.phone ? 420px : 460px;
        background: ShellTheme.ambient-primary;
        border-radius: 999px;
        opacity: root.phone ? 0.10 : 0.14;
    }

    Rectangle {
        x: root.width - (root.phone ? 260px : 320px);
        y: root.height - (root.phone ? 240px : 280px);
        width: root.phone ? 340px : 420px;
        height: root.phone ? 340px : 420px;
        background: ShellTheme.ambient-secondary;
        border-radius: 999px;
        opacity: 0.10;
    }

    lane := Rectangle {
        in property <int> max-shortcut-x: max(0, ((self.width - 108px) / 1px));
        in property <int> max-shortcut-y: max(0, ((self.height - 112px) / 1px));
        in-out property <bool> marquee-active: false;
        in-out property <length> marquee-start-x: 0px;
        in-out property <length> marquee-start-y: 0px;
        in-out property <length> marquee-end-x: 0px;
        in-out property <length> marquee-end-y: 0px;

        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        background: transparent;
        clip: false;

        lane-touch := TouchArea {
            pointer-event(event) => {
                if event.button != PointerEventButton.left {
                    if event.button == PointerEventButton.right && event.kind == PointerEventKind.down {
                        desktop-focus.focus();
                        root.clear-desktop-shortcut-selection();
                        root.context-menu-x = min(max(self.mouse-x + parent.x, 8px), root.width - 226px);
                        root.context-menu-y = min(max(self.mouse-y + parent.y, 8px), root.height - 162px);
                        root.context-menu-open = true;
                    }
                    return;
                }

                if event.kind == PointerEventKind.down {
                    desktop-focus.focus();
                    root.clear-desktop-shortcut-selection();
                    parent.marquee-active = true;
                    parent.marquee-start-x = self.mouse-x;
                    parent.marquee-start-y = self.mouse-y;
                    parent.marquee-end-x = self.mouse-x;
                    parent.marquee-end-y = self.mouse-y;
                } else if event.kind == PointerEventKind.move && self.pressed {
                    parent.marquee-end-x = self.mouse-x;
                    parent.marquee-end-y = self.mouse-y;
                } else if event.kind == PointerEventKind.up && parent.marquee-active {
                    parent.marquee-end-x = self.mouse-x;
                    parent.marquee-end-y = self.mouse-y;

                    if parent.marquee-end-x - parent.marquee-start-x > 6px
                        || parent.marquee-end-x - parent.marquee-start-x < -6px
                        || parent.marquee-end-y - parent.marquee-start-y > 6px
                        || parent.marquee-end-y - parent.marquee-start-y < -6px {
                        root.marquee-select-desktop-shortcuts(
                            min(parent.marquee-start-x, parent.marquee-end-x) / 1px,
                            min(parent.marquee-start-y, parent.marquee-end-y) / 1px,
                            abs(parent.marquee-end-x - parent.marquee-start-x) / 1px,
                            abs(parent.marquee-end-y - parent.marquee-start-y) / 1px,
                            parent.max-shortcut-x,
                            parent.max-shortcut-y
                        );
                    }

                    parent.marquee-active = false;
                }
            }
        }

        if lane.marquee-active: Rectangle {
            x: min(lane.marquee-start-x, lane.marquee-end-x);
            y: min(lane.marquee-start-y, lane.marquee-end-y);
            width: abs(lane.marquee-end-x - lane.marquee-start-x);
            height: abs(lane.marquee-end-y - lane.marquee-start-y);
            background: #ffb36a22;
            border-width: 1px;
            border-color: ShellTheme.accent;
            border-radius: 8px;
        }

        for shortcut in root.desktop-shortcuts: DesktopShortcut {
            app-id: shortcut.id;
            max-x: lane.max-shortcut-x;
            max-y: lane.max-shortcut-y;
            x: min(shortcut.x, self.max-x) * 1px + self.drag-offset-x;
            y: min(shortcut.y, self.max-y) * 1px + self.drag-offset-y;
            label: shortcut.name;
            icon-text: shortcut.icon_text;
            icon: shortcut.icon;
            active: shortcut.active;
            selected: shortcut.selected;
            draggable: true;
            compact: root.compact;

            selection-requested(app-id) => {
                desktop-focus.focus();
                root.select-desktop-shortcut(app-id);
            }

            moved(app-id, x, y, max-x, max-y) => {
                root.move-desktop-shortcut(app-id, x, y, max-x, max-y);
            }

            activated => {
                root.launch-app(shortcut.id);
            }
        }

    }

    Rectangle {
        x: min(max(root.info-widget-x + root.info-widget-drag-offset-x, 12px), root.width - self.width - 12px);
        y: min(max(root.info-widget-y + root.info-widget-drag-offset-y, 12px), root.height - self.height - 12px);
        width: root.desktop ? (root.wide ? 316px : 292px) : parent.width - 24px;
        height: root.phone ? 118px : 132px;
        background: #0b1420aa;
        border-radius: root.phone ? 18px : 20px;
        border-width: 1px;
        border-color: #ffffff22;

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: self.pressed ? grabbing : grab;

            pointer-event(event) => {
                if event.button != PointerEventButton.left {
                    return;
                }

                if event.kind == PointerEventKind.down {
                    root.info-widget-drag-start-x = parent.x;
                    root.info-widget-drag-start-y = parent.y;
                } else if event.kind == PointerEventKind.up {
                    root.info-widget-x = min(max(parent.x, 12px), root.width - parent.width - 12px);
                    root.info-widget-y = min(max(parent.y, 12px), root.height - parent.height - 12px);
                    root.info-widget-drag-offset-x = 0px;
                    root.info-widget-drag-offset-y = 0px;
                    root.info-widget-drag-start-x = 0px;
                    root.info-widget-drag-start-y = 0px;
                }
            }

            moved => {
                if self.pressed {
                    root.info-widget-drag-offset-x = parent.x + self.mouse-x - self.pressed-x - root.info-widget-drag-start-x;
                    root.info-widget-drag-offset-y = parent.y + self.mouse-y - self.pressed-y - root.info-widget-drag-start-y;
                }
            }
        }

        VerticalLayout {
            padding: root.phone ? 12px : 16px;
            spacing: root.phone ? 6px : 7px;

            Text {
                text: root.clock-text;
                color: ShellTheme.text-primary;
                font-size: root.phone ? 22px : 28px;
                font-weight: 800;
                overflow: elide;
            }

            Text {
                text: root.user-name + "  •  " + root.status-text;
                color: ShellTheme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 7px;

                ShellPill {
                    label: root.network-text;
                    tone: #ffffff10;
                    compact: true;
                    tiny: root.phone;
                }

                ShellPill {
                    label: root.audio-text;
                    tone: #ffffff10;
                    compact: true;
                    tiny: root.phone;
                }
            }

            Text {
                text: root.notification-count > 0
                    ? root.notification-count + " notifications waiting"
                    : root.power-text;
                color: ShellTheme.text-muted;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }

    if !root.phone && root.recent-files.length > 0: Rectangle {
        x: min(max(root.files-widget-x + root.files-widget-drag-offset-x, 12px), root.width - self.width - 12px);
        y: min(max(root.files-widget-y + root.files-widget-drag-offset-y, 12px), root.height - self.height - 12px);
        width: root.desktop ? (root.wide ? 316px : 292px) : parent.width - 24px;
        height: min(root.desktop ? 174px : 124px, 42px + root.recent-files.length * 42px);
        background: #0b1420aa;
        border-radius: 20px;
        border-width: 1px;
        border-color: #ffffff22;
        clip: true;

        TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: self.pressed ? grabbing : grab;

            pointer-event(event) => {
                if event.button != PointerEventButton.left {
                    return;
                }

                if event.kind == PointerEventKind.down {
                    root.files-widget-drag-start-x = parent.x;
                    root.files-widget-drag-start-y = parent.y;
                } else if event.kind == PointerEventKind.up {
                    root.files-widget-x = min(max(parent.x, 12px), root.width - parent.width - 12px);
                    root.files-widget-y = min(max(parent.y, 12px), root.height - parent.height - 12px);
                    root.files-widget-drag-offset-x = 0px;
                    root.files-widget-drag-offset-y = 0px;
                    root.files-widget-drag-start-x = 0px;
                    root.files-widget-drag-start-y = 0px;
                }
            }

            moved => {
                if self.pressed {
                    root.files-widget-drag-offset-x = parent.x + self.mouse-x - self.pressed-x - root.files-widget-drag-start-x;
                    root.files-widget-drag-offset-y = parent.y + self.mouse-y - self.pressed-y - root.files-widget-drag-start-y;
                }
            }
        }

        VerticalLayout {
            padding: 12px;
            spacing: 4px;

            Text {
                text: "Recent files";
                color: ShellTheme.text-primary;
                font-size: 12px;
                font-weight: 700;
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;

                VerticalLayout {
                    spacing: 4px;

                    for file in root.recent-files: RecentFileRow {
                        name: file.name;
                        detail: file.detail;

                        clicked => {
                            root.open-file(file.path);
                        }
                        reveal-clicked => {
                            root.reveal-file(file.path);
                        }
                    }
                }
            }
        }
    }

    for window in root.desktop-windows: WorkspaceWindow {
        app-id: window.id;
        title: window.name;
        detail: window.detail;
        icon-text: window.icon_text;
        icon: window.icon;
        focused: window.focused;
        minimized: window.minimized;
        maximized: window.maximized;
        max-x: max(0, ((root.width - min(window.width * 1px, root.width - 24px)) / 1px));
        max-y: max(0, ((root.height - min(window.height * 1px, root.height - 20px)) / 1px));
        x: window.maximized
            ? 12px
            : root.phone
            ? 12px + self.drag-offset-x
            : min(window.x, self.max-x) * 1px + self.drag-offset-x;
        y: window.maximized
            ? 12px
            : root.phone
            ? 14px + self.drag-offset-y
            : min(window.y, self.max-y) * 1px + self.drag-offset-y;
        width: window.maximized
            ? root.width - 24px
            : root.phone
            ? root.width - 24px
            : max(280px, min(window.width * 1px + self.resize-offset-x, root.width - 24px));
        height: window.maximized
            ? root.height - 24px
            : root.phone
            ? root.height - 24px
            : max(240px, min(window.height * 1px + self.resize-offset-y, root.height - 20px));

        focus-requested(id) => {
            root.focus-window(id);
        }

        minimized-requested(id) => {
            root.minimize-window(id);
        }

        maximized-requested(id) => {
            root.maximize-window(id);
        }

        closed-requested(id) => {
            root.close-window(id);
        }

        moved(id, x, y, max-x, max-y) => {
            root.move-window(id, x, y, max-x, max-y);
        }

        resized(id, width, height) => {
            root.resize-window(id, width, height);
        }
    }

    if root.context-menu-open: DesktopContextMenu {
        x: root.context-menu-x;
        y: root.context-menu-y;

        open-applications => {
            root.context-menu-open = false;
            root.show-launcher();
        }

        arrange-icons => {
            root.context-menu-open = false;
            root.auto-arrange-desktop-shortcuts(lane.max-shortcut-x, lane.max-shortcut-y);
        }

        open-command => {
            root.context-menu-open = false;
            root.show-command-surface();
        }

        close => {
            root.context-menu-open = false;
        }
    }
}
