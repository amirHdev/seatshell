import { LauncherApp } from "launcher.slint";
import { ShellTheme } from "shell-theme.slint";
import { ShellAction, ShellIcon, ShellPill } from "shell-widgets.slint";
import { ScrollView } from "std-widgets.slint";

export struct DesktopFile {
    path: string,
    name: string,
    detail: string,
}

export struct DesktopShortcutEntry {
    id: string,
    name: string,
    icon_text: string,
    icon: image,
    active: bool,
    selected: bool,
    x: int,
    y: int,
}

component DesktopShortcut inherits Rectangle {
    in property <string> app-id;
    in property <string> label;
    in property <string> icon-text;
    in property <image> icon;
    in property <bool> active: false;
    in property <bool> selected: false;
    in property <bool> draggable: false;
    in property <bool> compact: false;
    in property <int> max-x: 9999;
    in property <int> max-y: 9999;

    in-out property <length> drag-offset-x: 0px;
    in-out property <length> drag-offset-y: 0px;
    out property <bool> dragging: root.drag-offset-x > 6px
        || root.drag-offset-x < -6px
        || root.drag-offset-y > 6px
        || root.drag-offset-y < -6px;

    callback activated();
    callback selection-requested(string);
    callback moved(string, int, int, int, int);

    width: root.compact ? 92px : 108px;
    height: root.compact ? 96px : 112px;
    background: root.dragging
        ? #263a52d9
        : touch.has-hover || root.selected || root.active
            ? #101823cc
            : transparent;
    border-radius: 14px;
    border-width: touch.has-hover || root.selected || root.active ? 1px : 0px;
    border-color: root.selected || root.active ? ShellTheme.accent : #ffffff22;

    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: root.draggable ? (self.pressed ? grabbing : grab) : default;

        moved => {
            if root.draggable && self.pressed {
                root.drag-offset-x = self.mouse-x - self.pressed-x;
                root.drag-offset-y = self.mouse-y - self.pressed-y;
            }
        }

        pointer-event(event) => {
            if !root.draggable || event.button != PointerEventButton.left {
                return;
            }

            if event.kind == PointerEventKind.down {
                root.selection-requested(root.app-id);
            } else if event.kind == PointerEventKind.up {
                if root.drag-offset-x > 6px || root.drag-offset-x < -6px || root.drag-offset-y > 6px || root.drag-offset-y < -6px {
                    root.moved(
                        root.app-id,
                        min(max((root.x / 1px), 0), root.max-x),
                        min(max((root.y / 1px), 0), root.max-y),
                        root.max-x,
                        root.max-y
                    );
                }

                root.drag-offset-x = 0px;
                root.drag-offset-y = 0px;
            }
        }

        clicked => {
            if !root.draggable {
                root.activated();
            }
        }

        double-clicked => {
            root.activated();
        }
    }

    if root.dragging: Rectangle {
        x: 8px;
        y: parent.height - 24px;
        width: parent.width - 16px;
        height: 18px;
        background: ShellTheme.surface-accent;
        border-radius: 7px;
        border-width: 1px;
        border-color: ShellTheme.accent;

        Text {
            text: "SNAP";
            color: ShellTheme.text-accent;
            font-size: 8px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        width: root.compact ? 48px : 54px;
        height: root.compact ? 48px : 54px;
        x: (parent.width - self.width) / 2;
        y: root.compact ? 8px : 10px;
        border-radius: 14px;
        background: root.active ? #33271ed9 : #101823d9;
        border-width: 1px;
        border-color: root.active ? ShellTheme.accent : #ffffff28;

        if root.icon.width > 0 && root.icon.height > 0: Image {
            source: root.icon;
            width: root.compact ? 28px : 32px;
            height: root.compact ? 28px : 32px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        if root.icon.width == 0 || root.icon.height == 0: Text {
            text: root.icon-text;
            color: root.active ? ShellTheme.text-accent : ShellTheme.text-primary;
            font-size: root.compact ? 11px : 13px;
            font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Text {
        text: root.label;
        x: 4px;
        y: root.compact ? 62px : 70px;
        width: parent.width - 8px;
        height: root.compact ? 28px : 34px;
        color: ShellTheme.text-primary;
        font-size: root.compact ? 10px : 11px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: top;
        wrap: word-wrap;
        overflow: elide;
    }
}

component RecentFileRow inherits Rectangle {
    in property <string> name;
    in property <string> detail;

    callback clicked();

    height: 38px;
    horizontal-stretch: 1;
    background: touch.has-hover ? #ffffff0f : transparent;
    border-radius: 9px;

    animate background { duration: 120ms; }

    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 9px;
        alignment: center;

        Rectangle {
            width: 24px;
            height: 24px;
            background: #ffffff10;
            border-radius: 7px;
            border-width: 1px;
            border-color: #ffffff22;

            ShellIcon {
                x: 6px;
                y: 6px;
                width: 12px;
                height: 12px;
                name: "file";
                icon-color: ShellTheme.text-secondary;
            }
        }

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            Text {
                text: root.name;
                color: ShellTheme.text-primary;
                font-size: 10px;
                font-weight: 700;
                overflow: elide;
                horizontal-stretch: 1;
            }

            Text {
                text: root.detail;
                color: ShellTheme.text-muted;
                font-size: 9px;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }
    }
}

export component Desktop inherits Rectangle {
    in property <string> accent: "#4a90e2";
    in property <string> clock-text;
    in property <string> status-text: "Ready";
    in property <string> network-text: "NET";
    in property <string> power-text: "PWR";
    in property <string> audio-text: "VOL ?";
    in property <[LauncherApp]> apps;
    in property <[LauncherApp]> featured-apps;
    in property <[LauncherApp]> recent-apps;
    in property <[LauncherApp]> active-apps;
    in property <[DesktopFile]> recent-files;
    in property <[DesktopShortcutEntry]> desktop-shortcuts;
    in property <string> selected-shortcut-id;
    in property <string> user-name;
    in property <string> theme-name;
    in property <image> wallpaper-image;
    in property <int> app-count;
    in property <int> session-count;
    in property <int> notification-count;
    in property <bool> overview-enabled: true;

    in property <bool> phone: root.width < 560px;
    in property <bool> tablet: root.width >= 560px && root.width < 900px;
    in property <bool> desktop: root.width >= 900px;
    in property <bool> wide: root.width >= 1180px;
    in property <bool> compact: root.width < 700px;

    callback show-launcher();
    callback show-command-surface();
    callback show-overview();
    callback launch-app(string);
    callback open-file(string);
    callback select-desktop-shortcut(string);
    callback clear-desktop-shortcut-selection();
    callback select-all-desktop-shortcuts();
    callback marquee-select-desktop-shortcuts(int, int, int, int, int, int);
    callback move-desktop-shortcut-selection(int, int);
    callback nudge-selected-desktop-shortcuts(int, int, int, int);
    callback auto-arrange-desktop-shortcuts(int, int);
    callback move-desktop-shortcut(string, int, int, int, int);

    background: ShellTheme.background;
    forward-focus: desktop-focus;

    desktop-focus := FocusScope {
        x: 0px;
        width: 0px;

        key-pressed(event) => {
            if event.text == Key.Return {
                if root.selected-shortcut-id != "" {
                    root.launch-app(root.selected-shortcut-id);
                }
                accept
            } else if event.text == Key.Escape {
                root.clear-desktop-shortcut-selection();
                accept
            } else if event.text == "a" && event.modifiers.control && event.modifiers.shift {
                root.auto-arrange-desktop-shortcuts(lane.max-shortcut-x, lane.max-shortcut-y);
                accept
            } else if event.text == "a" && event.modifiers.control {
                root.select-all-desktop-shortcuts();
                accept
            } else if event.text == Key.LeftArrow {
                if event.modifiers.control {
                    root.nudge-selected-desktop-shortcuts(-1, 0, lane.max-shortcut-x, lane.max-shortcut-y);
                } else {
                    root.move-desktop-shortcut-selection(-1, 0);
                }
                accept
            } else if event.text == Key.RightArrow {
                if event.modifiers.control {
                    root.nudge-selected-desktop-shortcuts(1, 0, lane.max-shortcut-x, lane.max-shortcut-y);
                } else {
                    root.move-desktop-shortcut-selection(1, 0);
                }
                accept
            } else if event.text == Key.UpArrow {
                if event.modifiers.control {
                    root.nudge-selected-desktop-shortcuts(0, -1, lane.max-shortcut-x, lane.max-shortcut-y);
                } else {
                    root.move-desktop-shortcut-selection(0, -1);
                }
                accept
            } else if event.text == Key.DownArrow {
                if event.modifiers.control {
                    root.nudge-selected-desktop-shortcuts(0, 1, lane.max-shortcut-x, lane.max-shortcut-y);
                } else {
                    root.move-desktop-shortcut-selection(0, 1);
                }
                accept
            } else {
                reject
            }
        }
    }

    if root.wallpaper-image.width > 0 && root.wallpaper-image.height > 0: Image {
        source: root.wallpaper-image;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: root.phone ? #03070c66 : #03070c36;
    }

    Rectangle {
        x: root.phone ? -220px : -160px;
        y: root.phone ? -220px : -180px;
        width: root.phone ? 420px : 460px;
        height: root.phone ? 420px : 460px;
        background: ShellTheme.ambient-primary;
        border-radius: 999px;
        opacity: root.phone ? 0.10 : 0.14;
    }

    Rectangle {
        x: root.width - (root.phone ? 260px : 320px);
        y: root.height - (root.phone ? 240px : 280px);
        width: root.phone ? 340px : 420px;
        height: root.phone ? 340px : 420px;
        background: ShellTheme.ambient-secondary;
        border-radius: 999px;
        opacity: 0.10;
    }

    lane := Rectangle {
        in property <int> max-shortcut-x: max(0, ((self.width - 108px) / 1px));
        in property <int> max-shortcut-y: max(0, ((self.height - 112px) / 1px));
        in-out property <bool> marquee-active: false;
        in-out property <length> marquee-start-x: 0px;
        in-out property <length> marquee-start-y: 0px;
        in-out property <length> marquee-end-x: 0px;
        in-out property <length> marquee-end-y: 0px;

        x: root.desktop ? 28px : 12px;
        y: root.desktop
            ? 28px
            : root.phone
                ? 142px
                : root.recent-files.length > 0
                    ? 292px
                    : 156px;
        width: root.desktop
            ? root.wide ? 276px : 236px
            : parent.width - 24px;
        height: max(0px, root.desktop
            ? parent.height - 56px
            : parent.height - self.y - 12px);
        background: transparent;
        clip: true;

        lane-touch := TouchArea {
            pointer-event(event) => {
                if event.button != PointerEventButton.left {
                    return;
                }

                if event.kind == PointerEventKind.down {
                    desktop-focus.focus();
                    root.clear-desktop-shortcut-selection();
                    parent.marquee-active = true;
                    parent.marquee-start-x = self.mouse-x;
                    parent.marquee-start-y = self.mouse-y;
                    parent.marquee-end-x = self.mouse-x;
                    parent.marquee-end-y = self.mouse-y;
                } else if event.kind == PointerEventKind.move && self.pressed {
                    parent.marquee-end-x = self.mouse-x;
                    parent.marquee-end-y = self.mouse-y;
                } else if event.kind == PointerEventKind.up && parent.marquee-active {
                    parent.marquee-end-x = self.mouse-x;
                    parent.marquee-end-y = self.mouse-y;

                    if parent.marquee-end-x - parent.marquee-start-x > 6px
                        || parent.marquee-end-x - parent.marquee-start-x < -6px
                        || parent.marquee-end-y - parent.marquee-start-y > 6px
                        || parent.marquee-end-y - parent.marquee-start-y < -6px {
                        root.marquee-select-desktop-shortcuts(
                            min(parent.marquee-start-x, parent.marquee-end-x) / 1px,
                            min(parent.marquee-start-y, parent.marquee-end-y) / 1px,
                            abs(parent.marquee-end-x - parent.marquee-start-x) / 1px,
                            abs(parent.marquee-end-y - parent.marquee-start-y) / 1px,
                            parent.max-shortcut-x,
                            parent.max-shortcut-y
                        );
                    }

                    parent.marquee-active = false;
                }
            }
        }

        if lane.marquee-active: Rectangle {
            x: min(lane.marquee-start-x, lane.marquee-end-x);
            y: min(lane.marquee-start-y, lane.marquee-end-y);
            width: abs(lane.marquee-end-x - lane.marquee-start-x);
            height: abs(lane.marquee-end-y - lane.marquee-start-y);
            background: #ffb36a22;
            border-width: 1px;
            border-color: ShellTheme.accent;
            border-radius: 8px;
        }

        for shortcut in root.desktop-shortcuts: DesktopShortcut {
            app-id: shortcut.id;
            max-x: lane.max-shortcut-x;
            max-y: lane.max-shortcut-y;
            x: min(shortcut.x, self.max-x) * 1px + self.drag-offset-x;
            y: min(shortcut.y, self.max-y) * 1px + self.drag-offset-y;
            label: shortcut.name;
            icon-text: shortcut.icon_text;
            icon: shortcut.icon;
            active: shortcut.active;
            selected: shortcut.selected;
            draggable: root.desktop;
            compact: root.compact;

            selection-requested(app-id) => {
                desktop-focus.focus();
                root.select-desktop-shortcut(app-id);
            }

            moved(app-id, x, y, max-x, max-y) => {
                root.move-desktop-shortcut(app-id, x, y, max-x, max-y);
            }

            activated => {
                root.launch-app(shortcut.id);
            }
        }

        if root.desktop: Rectangle {
            x: 8px;
            y: parent.height - 54px;
            width: parent.width - 16px;
            height: 42px;
            background: #08111bcc;
            border-radius: 12px;
            border-width: 1px;
            border-color: #ffffff18;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 6px;
                alignment: center;

                Text {
                    text: root.selected-shortcut-id == ""
                        ? "Drag to select"
                        : "Ctrl + arrows move";
                    color: ShellTheme.text-muted;
                    font-size: 9px;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                ShellAction {
                    label: "Arrange";
                    icon-name: "apps";
                    compact: true;
                    tiny: true;

                    clicked => {
                        desktop-focus.focus();
                        root.auto-arrange-desktop-shortcuts(lane.max-shortcut-x, lane.max-shortcut-y);
                    }
                }
            }
        }
    }

    Rectangle {
        x: root.desktop ? parent.width - (root.wide ? 346px : 322px) : 12px;
        y: root.desktop ? 32px : 12px;
        width: root.desktop ? (root.wide ? 316px : 292px) : parent.width - 24px;
        height: root.phone ? 118px : 132px;
        background: #0b1420aa;
        border-radius: root.phone ? 18px : 20px;
        border-width: 1px;
        border-color: #ffffff22;

        VerticalLayout {
            padding: root.phone ? 12px : 16px;
            spacing: root.phone ? 6px : 7px;

            Text {
                text: root.clock-text;
                color: ShellTheme.text-primary;
                font-size: root.phone ? 22px : 28px;
                font-weight: 800;
                overflow: elide;
            }

            Text {
                text: root.user-name + "  •  " + root.status-text;
                color: ShellTheme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }

            HorizontalLayout {
                spacing: 7px;

                ShellPill {
                    label: root.network-text;
                    tone: #ffffff10;
                    compact: true;
                    tiny: root.phone;
                }

                ShellPill {
                    label: root.audio-text;
                    tone: #ffffff10;
                    compact: true;
                    tiny: root.phone;
                }
            }

            Text {
                text: root.notification-count > 0
                    ? root.notification-count + " notifications waiting"
                    : root.power-text;
                color: ShellTheme.text-muted;
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }

    if !root.phone && root.recent-files.length > 0: Rectangle {
        x: root.desktop ? parent.width - (root.wide ? 346px : 322px) : 12px;
        y: root.desktop ? 184px : 156px;
        width: root.desktop ? (root.wide ? 316px : 292px) : parent.width - 24px;
        height: min(root.desktop ? 174px : 124px, 42px + root.recent-files.length * 42px);
        background: #0b1420aa;
        border-radius: 20px;
        border-width: 1px;
        border-color: #ffffff22;
        clip: true;

        VerticalLayout {
            padding: 12px;
            spacing: 4px;

            Text {
                text: "Recent files";
                color: ShellTheme.text-primary;
                font-size: 12px;
                font-weight: 700;
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;

                VerticalLayout {
                    spacing: 4px;

                    for file in root.recent-files: RecentFileRow {
                        name: file.name;
                        detail: file.detail;

                        clicked => {
                            root.open-file(file.path);
                        }
                    }
                }
            }
        }
    }
}
